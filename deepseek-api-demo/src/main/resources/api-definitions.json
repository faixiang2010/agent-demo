  {
    "id": "chat-tools",
    "group": "对话补全",
    "name": "工具调用",
    "description": "声明 function 工具列表，模型返回 tool_calls 及参数。",
    "method": "POST",
    "path": "/chat/completions",
    "baseUrl": "https://api.deepseek.com",
    "streamable": true,
    "contentType": "application/json",
    "authMode": "bearer",
    "extraHeaders": null,
    "params": [
      {
        "name": "model",
        "label": "模型",
        "type": "select",
        "in": "body",
        "required": true,
        "defaultValue": "deepseek-flash",
        "options": [
          "deepseek-flash",
          "deepseek-v4-pro"
        ]
      }
    ],
    "example": {
      "model": "deepseek-flash",
      "messages": [
        {
          "role": "user",
          "content": "帮我查一下杭州今天的天气"
        }
      ],
      "tools": [
        {
          "type": "function",
          "function": {
            "name": "get_weather",
            "description": "查询指定城市的实时天气",
            "parameters": {
              "type": "object",
              "properties": {
                "city": {
                  "type": "string",
                  "description": "城市名称"
                }
              },
              "required": [
                "city"
              ]
            }
          }
        }
      ],
      "tool_choice": "auto",
      "stream": false
    },
    "imageKind": null,
    "notes": [
      "tool_choice 可选 none / auto / required，或指定 {\"type\":\"function\",\"function\":{\"name\":\"xxx\"}}。"
    ],
    "plain": "告诉 AI 你有哪些工具可用，让它自己决定调哪个、给什么参数。",
    "outputType": "chat"
  },
  {
    "id": "chat-prefix",
    "group": "对话补全",
    "name": "对话前缀续写（Beta）",
    "description": "让模型从指定的 assistant 前缀内容开始续写，需使用 /beta 前缀。",
    "method": "POST",
    "path": "/beta/chat/completions",
    "baseUrl": "https://api.deepseek.com",
    "streamable": true,
    "contentType": "application/json",
    "authMode": "bearer",
    "extraHeaders": null,
    "params": [
      {
        "name": "model",
        "label": "模型",
        "type": "select",
        "in": "body",
        "required": true,
        "defaultValue": "deepseek-v4-pro",
        "options": [
          "deepseek-flash",
          "deepseek-v4-pro"
        ]
      }
    ],
    "example": {
      "model": "deepseek-v4-pro",
      "messages": [
        {
          "role": "user",
          "content": "请写一个快速排序的 Python 实现"
