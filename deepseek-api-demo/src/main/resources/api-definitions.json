  {
    "id": "chat-basic",
    "group": "对话补全",
    "name": "基础对话",
    "description": "最常用的对话补全：system + user 消息，支持流式输出。",
    "method": "POST",
    "path": "/chat/completions",
    "baseUrl": "https://api.deepseek.com",
    "streamable": true,
    "contentType": "application/json",
    "authMode": "bearer",
    "extraHeaders": null,
    "params": [
      {
        "name": "model",
        "label": "模型",
        "type": "select",
        "in": "body",
        "required": true,
        "defaultValue": "deepseek-flash",
        "options": [
          "deepseek-flash",
          "deepseek-v4-pro"
        ]
      },
      {
        "name": "temperature",
        "label": "temperature",
        "type": "number",
        "in": "body",
        "required": false,
        "defaultValue": 1,
        "options": null
      },
      {
        "name": "max_tokens",
        "label": "max_tokens",
        "type": "number",
        "in": "body",
        "required": false,
        "defaultValue": 2048,
        "options": null
      }
    ],
    "example": {
      "model": "deepseek-flash",
      "messages": [
        {
          "role": "system",
          "content": "你是一个乐于助人的中文助手。"
        },
        {
          "role": "user",
          "content": "你好，请用一句话介绍你自己"
        }
      ],
      "temperature": 1,
      "max_tokens": 2048,
      "stream": false
    },
    "imageKind": null,
    "notes": [
      "支持流式输出：勾选上方「流式输出」后点击调用。"
    ],
    "plain": "最常用的聊天接口——发一句话，让 AI 回你一句话。",
    "outputType": "chat"
  },
  {
    "id": "chat-thinking",
    "group": "对话补全",
    "name": "思考模式",
    "description": "开启思维链推理，响应中返回 reasoning_content（思考过程）与 content（最终答案）。",
    "method": "POST",
    "path": "/chat/completions",
    "baseUrl": "https://api.deepseek.com",
    "streamable": true,
    "contentType": "application/json",
    "authMode": "bearer",
    "extraHeaders": null,
    "params": [
      {
        "name": "model",
        "label": "模型",
        "type": "select",
        "in": "body",
        "required": true,
        "defaultValue": "deepseek-v4-pro",
        "options": [
          "deepseek-flash",
          "deepseek-v4-pro"
        ]
      },
      {
        "name": "max_tokens",
        "label": "max_tokens",
        "type": "number",
        "in": "body",
        "required": false,
        "defaultValue": 4096,
        "options": null
      }
    ],
    "example": {
      "model": "deepseek-v4-pro",
      "messages": [
        {
          "role": "user",
          "content": "9.11 和 9.9 哪个大？请说明理由。"
        }
      ],
      "thinking": {
        "type": "enabled"
      },
      "reasoning_effort": "high",
      "max_tokens": 4096,
      "stream": false
    },
    "imageKind": null,
    "notes": [
      "thinking.type 默认即为 enabled，可设为 disabled 关闭。",
      "reasoning_effort 可选 high / max（low、medium 会映射为 high）。",
      "思考模式下 temperature、top_p 不生效。"
    ],
    "plain": "让 AI 先在心里想一遍再回答，适合需要推理的难题（数学、逻辑、比较大小等）。",
    "outputType": "chat"
  },
