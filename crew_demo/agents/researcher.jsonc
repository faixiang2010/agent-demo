{
  // Agent 的职位名称
  // 注意：这里我去掉了 {topic} 前缀，保持角色名干净
  "role": "高级研究专员",

  // Agent 的核心目标
  "goal": "查找关于 {topic} 的全面准确信息，重点关注最新进展和关键见解。",

  // Agent 的背景故事（设定人设）
  "backstory": "你是一位经验丰富的研究专家，擅长将复杂信息整理成清晰、有用的笔记。请始终用中文输出。",

  // 模型配置，与你 .env 里的保持一致
  "llm": "deepseek/deepseek-flash",

  // 允许使用的工具（无需 API Key 的基础工具）
  "tools": ["ScrapeWebsiteTool", "DirectoryReadTool", "FileReadTool", "FileWriterTool"],

  // Agent 行为设置
  "settings": {
    // 开启详细日志，方便你看到它工作的过程
    "verbose": true,
    
    // 不需要委派给其他 Agent（因为你只创建了一个）
    "allow_delegation": false,
    
    // 开启步进式规划
    "planning": true
  }
}