<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 最小 Demo：验证 agentscope-admin-spring-boot-starter 到底提供什么 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.4</version>
        <relativePath/>
    </parent>

    <groupId>demo</groupId>
    <artifactId>admin-demo</artifactId>
    <version>1.0.0</version>

    <properties>
        <java.version>17</java.version>
        <agentscope.version>2.0.4-SNAPSHOT</agentscope.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- AgentScope 基础自动配置（Memory/Toolkit/ReActAgent） -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-spring-boot-starter</artifactId>
            <version>${agentscope.version}</version>
        </dependency>

        <!-- 被验证对象：admin 运维 starter（纯后端，不含任何页面资源） -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-admin-spring-boot-starter</artifactId>
            <version>${agentscope.version}</version>
        </dependency>

        <!-- admin starter 中 harness 为 provided，需消费方自带 -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-harness</artifactId>
            <version>${agentscope.version}</version>
        </dependency>

        <!-- 提供 Model bean，自动装配出一个 ReActAgent 供 admin 登记 -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-dashscope-spring-boot-starter</artifactId>
            <version>${agentscope.version}</version>
        </dependency>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-model-dashscope</artifactId>
            <version>${agentscope.version}</version>
        </dependency>

        <!-- Servlet 容器（admin 数据面 REST 控制器仅在 SERVLET 环境注册） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 控制面 Actuator 端点（/actuator/agentscope-*） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- 可选：Swagger UI（starter 自带的唯一"网页"也仅是这个通用接口调试器，
             3.x 才支持 Spring Boot 4；starter 中声明的 2.6.0 只适用于 Boot 3） -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.1.1</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
